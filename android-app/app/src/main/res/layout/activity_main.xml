<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- Barra de Navegacao do Browser Integrado -->
    <LinearLayout
        android:id="@+id/urlBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="&lt;"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReload"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="R"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@color/bg_primary"
            android:hint="https://www.kwanzabet.ao"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:text="@string/default_url"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/accent_gold"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:text="Ir"
            android:textAllCaps="false"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra Rapida de Controle de Leitura -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/btnToggleScanner"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_emerald"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Leitura Auto: ATIVA"
            android:textAllCaps="false"
            android:textColor="@color/bg_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCalibrate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Calibrar Faixa"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnToggleBrowserBar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="URL"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Area Principal do Browser + Mira de Calibracao -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/roiOverlay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/roi_overlay_box"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/calibrationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:background="#EE131924"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alinhar sobre a faixa de resultados (0, 28, 9...)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Posicao Vertical (Topo)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekRoiTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="45"
                android:progress="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Altura da Faixa"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekRoiHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="18"
                android:progress="7" />

            <TextView
                android:id="@+id/tvCalibrationResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Toque em Testar Leitura para conferir os numeros."
                android:textColor="@color/accent_gold"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTestScan"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Testar Leitura"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCloseCalibrate"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_emerald"
                    android:text="Confirmar"
                    android:textAllCaps="false"
                    android:textColor="@color/bg_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Painel Inferior de Sugestoes + Taxa de Acertos -->
    <LinearLayout
        android:id="@+id/analysisPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSummarySuggestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Aguardando leitura da faixa..."
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAddManual"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="+ Giro"
                android:textAllCaps="false"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnExpandPanel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Detalhes"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAccuracyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Assertividade: aguardando giros..."
            android:textColor="@color/accent_emerald"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/historyChipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Secao Expandida: Todos os Campos, Ultimo Acerto/Erro, Percentuais por Mercado -->
        <LinearLayout
            android:id="@+id/expandedDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAllFieldsAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campos: -"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLastRoundHits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ultima rodada: -"
                android:textColor="@color/accent_gold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvMarketRates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Taxas por mercado: -"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBankrollAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Gestao AOA: -"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLearnedCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Memoria SQLite: 0 giros"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClearHistory"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Limpar Sessao"
                    android:textAllCaps="false"
                    android:textColor="@color/roulette_red"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
